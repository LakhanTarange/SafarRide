rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid;

      allow read: if request.auth != null
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.partnerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || resource.data.status == 'requested'
          || isAdmin()
        );

      allow update: if request.auth != null
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.partnerId == request.auth.uid
          || (
            resource.data.status == 'requested'
            && request.resource.data.partnerId == request.auth.uid
          )
          || (
            resource.data.status == 'requested'
            && request.resource.data.rejectedBy == request.auth.uid
          )
          || (
            resource.data.driverId == request.auth.uid
            && resource.data.status == 'driver_assigned'
            && request.resource.data.status == 'started'
            && request.resource.data.tripStartedBy == request.auth.uid
          )
          || (
            resource.data.driverId == request.auth.uid
            && resource.data.status == 'started'
            && request.resource.data.status == 'completed'
            && request.resource.data.completedBy == request.auth.uid
          )
          || isAdmin()
        );

      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow update: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow delete: if false;
    }

    match /drivers/{driverId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.uid == request.auth.uid
          || (
            request.auth.token.email != null
            && resource.data.email == request.auth.token.email
          )
          || isAdmin()
        );

      allow update: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || (
            request.auth.token.email != null
            && resource.data.email == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'uid',
              'updatedAt',
              'isAvailable'
            ])
          )
          || isAdmin()
        );

      allow delete: if false;
    }

    match /carpools/{carpoolId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if request.auth != null;

      allow update: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'bookedSeats',
              'passengers',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    match /complaints/{complaintId} {
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid;

      allow read: if request.auth != null
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.partnerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || isAdmin()
        );

      allow update: if request.auth != null && isAdmin();

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}